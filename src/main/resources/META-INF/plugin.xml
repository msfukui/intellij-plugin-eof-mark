<idea-plugin>
    <id>com.github.msfukui.intellijplugineofmark</id>
    <name>EOF Mark</name>
    <vendor>msfukui</vendor>

    <description><![CDATA[
    Displays an [EOF] marker at the end of files in the editor.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <applicationListeners>
        <listener
            class="com.github.msfukui.intellijplugineofmark.EofMarkEditorListener"
            topic="com.intellij.openapi.editor.event.EditorFactoryListener"/>
    </applicationListeners>
</idea-plugin>
